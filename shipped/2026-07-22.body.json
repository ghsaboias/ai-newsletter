             "rel": "noopener noreferrer nofollow",
             "target": "_blank",
             "class": null
            }
           }
          ],
          "text": "Saiu do ",
          "type": "text"
         },
         {
          "marks": [
           {
            "attrs": {
             "rel": "noopener noreferrer nofollow",
             "class": null,
             "target": "_blank",
