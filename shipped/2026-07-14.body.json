     {
      "type": "text",
      "text": "Demis Hassabis propõe órgão privado nos moldes da FINRA para fiscalizar a IA de fronteira"
     }
    ]
   },
   {
    "type": "bullet_list",
    "content": [
     {
      "type": "list_item",
      "content": [
       {
