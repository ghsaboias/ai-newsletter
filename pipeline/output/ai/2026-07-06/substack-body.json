             "rel": "noopener noreferrer nofollow",
             "class": null
            }
           }
          ],
          "text": "levantar quase HK$7,07 bilhões (~US$892,5 milhões)"
         },
         {
          "type": "text",
          "text": ". A ação subiu mais de 150% desde o IPO de janeiro de 2026, e cerca de 60% dos recursos irão para acelerar a comercialização e produção de produtos de próxima geração."
         }
        ]
       }
      ]
